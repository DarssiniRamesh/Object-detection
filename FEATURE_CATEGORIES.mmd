%% Mermaid mindmap diagram with explicit styling for dark-theme readability.
%%
%% Goal:
%% - Avoid light/yellow-ish fills that reduce readability in dark UIs
%% - Ensure high-contrast text and borders
%% - Keep diagram background transparent so the surrounding page theme shows through
%%
%% Note: Different Mermaid renderers vary in which themeVariables they honor for mindmaps.
%% These variables cover the common cases and are intentionally explicit.

%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "transparent",

    "primaryColor": "#111827",
    "secondaryColor": "#1f2937",
    "tertiaryColor": "#374151",

    "primaryBorderColor": "#e5e7eb",
    "secondaryBorderColor": "#d1d5db",
    "tertiaryBorderColor": "#cbd5e1",

    "textColor": "#f9fafb",
    "primaryTextColor": "#f9fafb",
    "secondaryTextColor": "#f9fafb",
    "tertiaryTextColor": "#f9fafb",

    "nodeTextColor": "#f9fafb",
    "rootNodeTextColor": "#ffffff",

    "lineColor": "#d1d5db"
  }
}}%%

mindmap
  root((Feature Categories))
    Training
      Single-node
      Multi-node / SubmitIt
      Detectron2 wrapper
    Evaluation
      COCO metrics
      Panoptic metrics
    Models
      DETR (R50/R101)
      DC5 variants
      Segmentation head
    Export
      TorchScript
      ONNX
    Utilities
      Plotting
      Box ops
      Transforms
